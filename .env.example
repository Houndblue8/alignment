# Client (safe to expose, put real values in .env.local and in Vercel project settings)
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_VAPID_PUBLIC_KEY=your-vapid-public-key

# Server only. Never in .env.local or Vercel. Set with: supabase secrets set NAME=value
# SUPABASE_SERVICE_ROLE_KEY=
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL_PARSE=claude-sonnet-5-5
# ANTHROPIC_MODEL_COACH=claude-haiku-5-5
# VAPID_PRIVATE_KEY=
# VAPID_SUBJECT=mailto:you@example.com
